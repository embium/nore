set -euo pipefail
DIR="$HOME/.logs/nore"
mkdir -p "$DIR"
LOGFILE="$HOME/.logs/nore/python.log"
echo >> $LOGFILE

log() {
    local LINE="$1"
    local DATE="$(date +'%Y-%m-%d')"
    local TIME="$(date +'%H:%M:%S')"
    echo "[$DATE][$TIME][hermit][DEBUG] $LINE" >> $LOGFILE
}
trap 'log "ERROR: Exiting w/ status: $?."' ERR

log "Starting..."

log "mkdir -p ~/.config/nore/hermit/bin ?"
mkdir -p ~/.config/nore/hermit/bin

log "cd ~/.config/nore/hermit"
cd ~/.config/nore/hermit

if [ ! -f ~/.config/nore/hermit/bin/hermit ]; then
    log "Downloading hermit..."
    curl -fsSL "https://github.com/cashapp/hermit/releases/download/stable/hermit-$(uname -s \
        | tr '[:upper:]' '[:lower:]')-$(uname -m \
        | sed 's/x86_64/amd64/' \
        | sed 's/aarch64/arm64/').gz" \
        | gzip -dc > ~/.config/nore/hermit/bin/hermit
    log "Downloaded hermit..."

    log "chmod +x ~/.config/nore/hermit/bin/hermit"
    chmod +x ~/.config/nore/hermit/bin/hermit
else
    log "Found existing hermit..."
fi

log "mkdir -p ~/.config/nore/hermit/cache"
mkdir -p ~/.config/nore/hermit/cache

log "export HERMIT_STATE_DIR=~/.config/nore/hermit/cache"
export HERMIT_STATE_DIR=~/.config/nore/hermit/cache

log "export PATH=~/.config/nore/hermit/bin:$PATH"
export PATH=~/.config/nore/hermit/bin:$PATH

log "Checking for running hermit processes..."
if pgrep -f hermit > /dev/null; then
    log "Found running hermit processes, waiting for them to complete..."
    sleep 5
    if pgrep -f hermit > /dev/null; then
        log "Hermit processes still running, attempting to continue anyway..."
    else
        log "Hermit processes completed"
    fi
fi

# Create a temporary copy of hermit for initialization
log "Creating temporary copy of hermit for initialization"
cp ~/.config/nore/hermit/bin/hermit ~/.config/nore/hermit/bin/hermit.tmp 2>> "$LOGFILE" || log "Failed to create temp copy"
chmod +x ~/.config/nore/hermit/bin/hermit.tmp 2>> "$LOGFILE" || log "Failed to make temp copy executable"

log "Running hermit init with temporary binary"
if ~/.config/nore/hermit/bin/hermit.tmp init >> "$LOGFILE" 2>&1; then
    log "hermit init succeeded"
else
    ERROR_CODE=$?
    log "hermit init failed with exit code $ERROR_CODE. See $LOGFILE for details."
    # Continue anyway as it might still work
fi

# Clean up temp file
rm -f ~/.config/nore/hermit/bin/hermit.tmp 2>> "$LOGFILE" || log "Failed to remove temp copy"

log "hermit install python@3.12"

# Check for running hermit processes again
log "Checking for running hermit processes before python install..."
if pgrep -f hermit > /dev/null; then
    log "Found running hermit processes, waiting for them to complete..."
    sleep 5
fi

# Create another temporary copy of hermit for python installation
log "Creating temporary copy of hermit for python installation"
cp ~/.config/nore/hermit/bin/hermit ~/.config/nore/hermit/bin/hermit.python.tmp 2>> "$LOGFILE" || log "Failed to create temp copy for python install"
chmod +x ~/.config/nore/hermit/bin/hermit.python.tmp 2>> "$LOGFILE" || log "Failed to make python temp copy executable"

log "Running hermit install python with temporary binary"
if ~/.config/nore/hermit/bin/hermit.python.tmp install python3@3.12 >> "$LOGFILE" 2>&1; then
    log "hermit install python succeeded"
else
    ERROR_CODE=$?
    log "hermit install python failed with exit code $ERROR_CODE. See $LOGFILE for details."
    # Continue anyway as python might still work with system python
fi

# Clean up temp file
rm -f ~/.config/nore/hermit/bin/hermit.python.tmp 2>> "$LOGFILE" || log "Failed to remove python temp copy"

log "python $*"
python "$@" || log "Error running python $*"

log "End."
